{
  "name": "plantt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/schema.test.mjs && node test/themes.test.mjs",
    "db:local": "wrangler d1 migrations apply plantt --local",
    "db:remote": "wrangler d1 migrations apply plantt --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name plantt"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "allowScripts": {
    "workerd@1.20260911.1": true
  }
}
